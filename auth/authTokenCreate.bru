meta {
  name: authTokenCreate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/token/
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{phone}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("token",res.getBody()['access'])
}

example {
  name: example
  
  request: {
    url: {{baseUrl}}/auth/token/
    method: POST
    mode: json
    body:json: {
      {
        "phone": "{{phone}}",
        "password": "{{password}}"
      }
    }
  }
  
