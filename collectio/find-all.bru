meta {
  name: find-all
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/collection/chat/query/?action=find&project=20
  body: json
  auth: inherit
}

params:query {
  action: find
  project: 20
}

body:json {
  {
    "limit": 100,
    "skip": 0,
    "sort": {
      "avatar": 1
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
